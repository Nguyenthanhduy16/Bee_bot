# Example names only. Store actual values outside Git with restrictive permissions.
# Receive-only webhook does not require a Bot Token; API calls will later need one.
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=
BEE_BOT_ZALO_IDENTITIES=/ABS/PATH/PRIVATE/zalo-identities.json
BEE_BOT_ZALO_INBOX=/ABS/PATH/Bee_Bot/.bee-bot/zalo-inbox.db
# identities file is trusted admin mapping: {"zalo-sender-id":"labcoach-person-id"}
# Role is read from the authorized people directory by the service, never from Zalo text/display_name.
